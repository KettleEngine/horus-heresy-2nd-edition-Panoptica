    <selectionEntry type="upgrade" import="true" name="Power Field" hidden="false" id="97e4-e925-d6a4-3463">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7c31-35a2-a004-f3c9-min" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7c31-35a2-a004-f3c9-max" includeChildSelections="false"/>
      </constraints>
      <profiles>
        <profile name="Power Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b199-5773-d659-81ea">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Power Field confers a 5+ Invulnerable Save, and any model with a Power Field and a Wounds Characteristic that suffers an unsaved Wound with the Instant Death special rule is not immediately removed as a casualty, but instead loses D3 Wounds instead of one for each unsaved Wound with the Instant Death special rule inflicted on it. In addition, when a model with a Power Field loses its last Wound or Hull Point, but before it is removed as a casualty or replaced with a Wreck, all models both friendly and enemy within D6&quot; suffer an automatic Hit at Str 8, AP -.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ghostwalker Matrix" hidden="false" id="0517-087e-3a1e-a216">
      <profiles>
        <profile name="Ghostwalker Matrix" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="616a-fb34-bc18-cd29">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with a Ghostwalker Matrix has the Move Through Cover Special Rule.


If the model that selected a Ghostwalker Matrix has the Antigrav Unit Sub-type, it gains the Pathfinder Special Rule instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Move Through Cover" id="4991-3bec-8d06-ab3c" hidden="false" type="rule" targetId="2b6f-bfec-759e-1746"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Starcannon" hidden="false" id="cef9-67ab-7179-e737">
      <profiles>
        <profile name="Starcannon" typeId="1a1a-e592-2849-a5c0" typeName="Weapon" hidden="false" id="5d32-1e68-479d-0a63">
          <characteristics>
            <characteristic name="Range" typeId="95ba-cda7-b831-6066">36&quot;</characteristic>
