        <profile name="Aspect Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7e03-ccd9-41c1-86f1" publicationId="a179-8e8f-4601-987c" page="160">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Aspect Armour confers a 4+ Armour Save and a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
