          </modifiers>
        </infoLink>
        <infoLink name="One Use/One Shot" id="130b-1d76-1341-d77a" hidden="false" type="rule" targetId="df0c-5423-b892-491e"/>
        <infoLink name="Ignores Cover" id="4cbe-d88f-0c9a-04c3" hidden="false" type="rule" targetId="fdb5-59e2-c446-1cbc"/>
      </infoLinks>
      <constraints>
