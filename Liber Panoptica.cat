                <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 1, Fleshbane, Torrent (9“), Breaching (6+), Psychic Focus</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
