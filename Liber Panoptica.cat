      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Crystal Targeting Matrix" hidden="false" id="e17f-bc6d-78b0-3ae6">
      <profiles>
        <profile name="Crystal Targeting Matrix" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2539-3b4c-701a-4bfc" publicationId="a179-8e8f-4601-987c" page="162">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per game, a model equipped with a Crystal Targeting Matrix may choose to fire a single weapon it is armed with at its full Ballistic Skill Characteristic in the Controlling Player’s Shooting Phase after moving Flat Out.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="57b6-9ec5-0ab2-c499" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
