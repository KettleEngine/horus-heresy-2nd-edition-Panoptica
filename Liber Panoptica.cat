      <profiles>
        <profile name="Heavy Aspect Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="cd88-1030-4596-8fa6" publicationId="a179-8e8f-4601-987c" page="160">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Heavy Aspect Armour confers a 3+ Armour Save and a 5+ Invulnerable Save</characteristic>
          </characteristics>
